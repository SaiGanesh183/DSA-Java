class Solution {
    public int numOfSubarrays(int[] arr, int k, int threshold) {
        int count=0;
        double temp=0;
        for(int i=0;i<k;i++) {
            temp+=arr[i];
        }
         if(temp/k>=threshold) {
                count++;
            }
        int i=0;
        int j=k;
        while(j<arr.length) {
            temp+=arr[j];
            temp-=arr[i];
            if(temp/k>=threshold) {
                count++;
            }
            j++;
            i++;
        }
        return count;
    }
}